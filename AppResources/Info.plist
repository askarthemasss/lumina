	<string>Lumina does not record audio. This permission is only requested by macOS if you choose to transcribe a recording you already own.</string>
	<key>NSDesktopFolderUsageDescription</key>
	<string>Lumina needs access only to the folders you explicitly choose in order to index them.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>Lumina needs access only to the folders you explicitly choose in order to index them.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Lumina needs access only to the folders you explicitly choose in order to index them.</string>
	<key>LSMultipleInstancesProhibited</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
