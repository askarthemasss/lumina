<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Lumina is intentionally not sandboxed. It indexes folders the user
	  explicitly selects, including folders outside the sandbox container.
	  Distribution is direct (signed + notarized), not via the Mac App Store.
	  See README.md → "Why isn't Lumina sandboxed?".
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
